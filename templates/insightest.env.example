# Insightest — local configuration for k6 performance runs.
#
# This file is NOT committed: it holds the project API key, so it is per-machine.
# `k6w init` (and the SDK's postinstall) add it to .gitignore when they create it.
#
# It is parsed, never sourced — KEY=VALUE lines only, no command substitution, no
# shell. Anything already set in the real environment wins over this file, which
# is how CI injects its own key without having a file at all. An empty value here
# counts as unset.

# The Insightest instance to register runs against.
INSIGHTEST_API_URL=http://localhost:4000

# Which project these tests belong to, as its project key — e.g. 91life_medical-apps.
# Insightest shows it under "Run performance tests" on the project. It is not a
# secret, and it does not change when the project is renamed.
#
# Optional, because the API key below already identifies the project. Worth setting
# anyway: with both present, a repo holding the wrong project's key is rejected
# outright instead of quietly recording its runs against that other project.
INSIGHTEST_PROJECT=

# The project's API key. Copy it from the same place — "Run performance tests" →
# "Copy token". Everyone with access to the project sees the same token, so this is
# the project's key rather than yours; there is no need to generate your own.
INSIGHTEST_INGEST_API_KEY=

# The k6 binary to run. Must be the xk6-clickhouse build, or the run streams no
# metrics to ClickHouse and never appears in the dashboard. `k6w install-k6` builds
# the right one and puts it here; point this elsewhere to use your own.
# A relative path resolves against the directory holding this file, so runs from a
# subdirectory of the repo work too.
K6W_K6_BIN=tools/k6/k6

# Per-run choices stay on the command line and are deliberately not set here.
# K6W_CONTAINER is the clearest example — which containers to sample Docker stats
# from depends on what you are testing right now, so pass it per invocation:
#   K6W_CONTAINER=opensearch npx k6w run tests/load-test.js -o xk6-clickhouse

# Optional: which stored environment profile to load from Insightest. Every
# project has "default"; another name is overlaid on top of it.
# K6W_ENV=default
