#!/bin/bash
set -euo pipefail

# Absolute path to this wrapper, captured before any `cd` so the `rerun`
# subcommand can re-exec it from the original test's working directory.
K6W_SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# ---------------------------------------------------------------------------
# The k6 toolchain this SDK release is built against. Pinned here, in one place,
# because the two halves are coupled: the ClickHouse output extension decides the
# shape of what lands in the metrics store, and Insightest reads that shape back.
# A binary built with a different extension version can stream metrics that never
# show up in the dashboard, with nothing visibly wrong at either end.
#
# `k6w install-k6` builds exactly this combination, so the wrapper and the binary it
# delegates to cannot drift. Changing either version means cutting an SDK release.
K6W_K6_VERSION="v2.0.0"
K6W_XK6_EXTENSION="github.com/mkutlak/xk6-output-clickhouse@v0.6.0"
# Image used to build without requiring a Go toolchain on the host.
K6W_XK6_IMAGE="grafana/xk6"
# Where install-k6 puts the binary when .insightest.env does not say otherwise.
# Relative to the repo root, and language-agnostic on purpose: the SDK is consumed
# by Node, Go and Python repos, and none of their conventions fit the others.
K6W_DEFAULT_K6_BIN="tools/k6/k6"

# ---------------------------------------------------------------------------
# Client-side configuration: one file, .insightest.env, at the root of the test
# repository. It holds everything a run needs that is not the k6 command itself —
# which Insightest to talk to, the project API key, which k6 binary to use, which
# containers to sample — so none of it has to be retyped on every invocation.
#
# The file is not committed: it holds the key. `k6w init` and the SDK's postinstall
# both create it from templates/insightest.env.example and add it to .gitignore.
#
# Precedence is always environment first: a variable already set in this shell is
# never overwritten, so CI injects INSIGHTEST_INGEST_API_KEY from its own secret
# store, has no file, and none of this matters. A one-off
# `INSIGHTEST_API_URL=… k6w run …` likewise still points where it was told to.
#
# The file is parsed, never sourced — a file that executes shell on every load test
# is the risk the protected-name list further down exists to prevent.

# Trim surrounding whitespace and one layer of matching quotes.
_k6w_trim() {
  local s="${1%$'\r'}"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  if [[ ${#s} -ge 2 && "${s:0:1}" == '"' && "${s: -1}" == '"' ]]; then
    s="${s:1:${#s}-2}"
  elif [[ ${#s} -ge 2 && "${s:0:1}" == "'" && "${s: -1}" == "'" ]]; then
    s="${s:1:${#s}-2}"
  fi
  printf '%s' "${s}"
}

K6W_ENV_FILE_NAME=".insightest.env"

# Locate the env file: an explicit K6W_ENV_FILE, else the nearest .insightest.env
# found by walking up from the current directory, the way git finds its own config.
# Running a test from a subdirectory of the repo therefore works unchanged.
_k6w_find_env_file() {
  if [[ -n "${K6W_ENV_FILE:-}" ]]; then
    printf '%s' "${K6W_ENV_FILE}"
    return
  fi
  local dir="${PWD}"
  while [[ -n "${dir}" ]]; do
    if [[ -f "${dir}/${K6W_ENV_FILE_NAME}" ]]; then
      printf '%s' "${dir}/${K6W_ENV_FILE_NAME}"
      return
    fi
    [[ "${dir}" == "/" ]] && break
    dir="$(dirname "${dir}")"
  done
  printf ''
}

# Path of the loaded file, so later messages can name it. Empty when none was found.
K6W_ENV_FILE_LOADED=""

# The repo the tests belong to: the directory holding .insightest.env, else the
# current directory. Relative paths in that file resolve against this rather than
# against $PWD, so `K6W_K6_BIN=tools/k6/k6` keeps working when a test is run from a
# subdirectory — the file is found by walking up, and its contents should not mean
# something different depending on how deep you were standing.
_k6w_repo_root() {
  if [[ -n "${K6W_ENV_FILE_LOADED}" ]]; then
    dirname "${K6W_ENV_FILE_LOADED}"
    return
  fi
  printf '%s' "${PWD}"
}

# Absolute form of a path that may be relative to the repo root.
_k6w_abs_path() {
  local p="$1"
  [[ "${p}" == /* ]] && { printf '%s' "${p}"; return; }
  printf '%s/%s' "$(_k6w_repo_root)" "${p}"
}

_load_env_file() {
  local file; file="$(_k6w_find_env_file)"
  if [[ -z "${file}" ]]; then
    # Not an error: the environment may carry everything already (CI), and the
    # wrapper still has a default API URL. Anything genuinely missing is reported
    # by name later, by the config fetch or by k6 itself.
    return 0
  fi
  if [[ ! -r "${file}" ]]; then
    echo "[k6w] Warning: cannot read ${file}" >&2
    return 0
  fi
  K6W_ENV_FILE_LOADED="${file}"

  # A file holding an API key that other accounts on the host can read is worth
  # saying out loud, but not worth refusing to run over — the run would fail
  # confusingly a moment later for an unrelated-looking reason.
  local mode
  mode="$(stat -c '%a' "${file}" 2>/dev/null || stat -f '%Lp' "${file}" 2>/dev/null || printf '')"
  if [[ -n "${mode}" && "${mode}" != "600" && "${mode}" != "400" ]]; then
    echo "[k6w] Warning: ${file} is mode ${mode} and holds an API key — chmod 600 it" >&2
  fi

  local applied=0 lineno=0 line name value
  while IFS= read -r line || [[ -n "${line}" ]]; do
    lineno=$((lineno + 1))
    line="$(_k6w_trim "${line}")"
    [[ -z "${line}" || "${line}" == \#* || "${line}" == \;* || "${line}" != *=* ]] && continue
    # `export FOO=bar` is what people paste out of habit; accept it.
    [[ "${line}" == export[[:space:]]* ]] && line="$(_k6w_trim "${line#export}")"
    name="$(printf '%s' "${line%%=*}" | tr -d '[:space:]')"
    value="$(_k6w_trim "${line#*=}")"
    if [[ ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]{0,127}$ ]]; then
      echo "[k6w] Warning: ignoring malformed variable name at ${file}:${lineno}" >&2
      continue
    fi
    # An empty value in the file counts as unset — the shipped template ships
    # INSIGHTEST_INGEST_API_KEY= and K6W_CONTAINER= blank, and exporting those
    # empty would only mask the real diagnostics.
    [[ -z "${value}" ]] && continue
    # Already set in this shell: leave it alone. Written as `if` rather than an
    # AND-list because under `set -e` a failing AND-list at the end of a loop
    # body becomes the status of the loop and kills the run.
    if [[ -n "${!name:-}" ]]; then
      continue
    fi
    export "${name}=${value}"
    applied=$((applied + 1))
  done < "${file}"

  echo "[k6w] Loaded ${applied} variable(s) from ${file}"
  if [[ -n "${INSIGHTEST_INGEST_API_KEY:-}" ]]; then
    # Only the prefix, which is what Insightest itself displays for a key.
    echo "[k6w] Using API key ${INSIGHTEST_INGEST_API_KEY:0:10}…"
  fi
}

# The one protection carried over from the file this replaces: .insightest was
# committed, so a key found in it was a leaked key and fatal. .insightest.env is
# meant to be ignored, so a key in it is not yet leaked — but if the ignore rule is
# missing it is one `git add` away from being published, which is worth interrupting
# for. A warning rather than an exit: the right fix is one line in .gitignore, and
# failing the run would be a disproportionate way to ask for it.
_warn_if_env_file_tracked() {
  [[ -n "${K6W_ENV_FILE_LOADED}" && -n "${INSIGHTEST_INGEST_API_KEY:-}" ]] || return 0
  command -v git > /dev/null 2>&1 || return 0
  local dir; dir="$(dirname "${K6W_ENV_FILE_LOADED}")"
  git -C "${dir}" rev-parse --is-inside-work-tree > /dev/null 2>&1 || return 0
  git -C "${dir}" check-ignore -q "${K6W_ENV_FILE_LOADED}" 2>/dev/null && return 0
  echo "[k6w] ============================================================" >&2
  echo "[k6w] WARNING: ${K6W_ENV_FILE_LOADED} holds an API key and is NOT" >&2
  echo "[k6w]          git-ignored. Add this line to .gitignore before you commit:" >&2
  echo "[k6w]            ${K6W_ENV_FILE_NAME}" >&2
  echo "[k6w]          Or run 'k6w init', which adds it for you." >&2
  echo "[k6w] ============================================================" >&2
}

# Add one pattern to the repo's .gitignore, if it is not already covered.
#
# Only ever amends an existing .gitignore: creating one in a repo that has none is a
# decision about that repository, not about the file being ignored.
_k6w_ensure_gitignored() {
  local pattern="$1" comment="$2"
  local ignore; ignore="$(_k6w_repo_root)/.gitignore"
  if [[ ! -f "${ignore}" ]]; then
    echo "[k6w] Warning: no .gitignore here — make sure ${pattern} is not committed" >&2
    return 0
  fi
  if grep -qxF "${pattern}" "${ignore}" 2>/dev/null \
    || grep -qxF "/${pattern}" "${ignore}" 2>/dev/null; then
    return 0
  fi
  # A file not ending in a newline would otherwise get this appended to its last line,
  # silently changing an unrelated pattern.
  if [[ -s "${ignore}" && -n "$(tail -c 1 "${ignore}" 2>/dev/null)" ]]; then
    printf '\n' >> "${ignore}"
  fi
  printf '\n# %s\n%s\n' "${comment}" "${pattern}" >> "${ignore}"
  echo "[k6w] Added ${pattern} to .gitignore"
}

# GOOS/GOARCH for the machine this is running on.
#
# This is the detail the plain `docker run grafana/xk6 build …` command gets wrong
# away from Linux: the build happens inside a Linux container, so it produces a Linux
# binary, which a macOS host cannot execute. xk6 honours GOOS/GOARCH, so passing the
# host's own values cross-compiles for wherever the run will actually happen.
_k6w_host_goos() {
  case "$(uname -s 2>/dev/null || printf 'Linux')" in
    Darwin) printf 'darwin' ;;
    Linux)  printf 'linux' ;;
    MINGW* | MSYS* | CYGWIN*) printf 'windows' ;;
    *) printf 'linux' ;;
  esac
}
_k6w_host_goarch() {
  case "$(uname -m 2>/dev/null || printf 'x86_64')" in
    x86_64 | amd64) printf 'amd64' ;;
    aarch64 | arm64) printf 'arm64' ;;
    armv7l) printf 'arm' ;;
    *) printf 'amd64' ;;
  esac
}

# Does this binary advertise the clickhouse output extension?
_k6w_has_clickhouse() {
  local bin="$1"
  [[ -x "${bin}" ]] || return 1
  "${bin}" version 2>/dev/null | grep -qi 'clickhouse'
}

# Build the k6 binary this SDK release is pinned to, into the location the repo's
# config points at (default tools/k6/k6), and make sure git ignores it.
#
# Two ways to build, in order of how little the host has to have installed:
#
#   1. Docker, using grafana/xk6. Needs no Go toolchain — which is the point, since
#      the repos consuming this SDK are Node, Go and Python, and only one of those
#      can be assumed to have Go. Cross-compiled for the host via GOOS/GOARCH.
#   2. A native xk6 already on PATH, for a host with Go set up and no Docker.
#
# Both need network access on first run: either pulling the image or fetching the Go
# modules the extension depends on.
#
# Idempotent. An existing binary that already advertises the extension is left alone,
# because rebuilding it takes minutes and changes nothing.
_do_install_k6() {
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1

  local rel="${K6W_K6_BIN:-${K6W_DEFAULT_K6_BIN}}"
  local dest; dest="$(_k6w_abs_path "${rel}")"
  local dest_dir; dest_dir="$(dirname "${dest}")"
  local dest_name; dest_name="$(basename "${dest}")"

  # The ignore pattern has to be written the way .gitignore reads it: relative to the
  # repo root. A destination outside the repo is not ours to ignore.
  local root; root="$(_k6w_repo_root)"
  local rel_dest="${dest#"${root}/"}"

  if [[ ${force} -eq 0 && -x "${dest}" ]]; then
    if _k6w_has_clickhouse "${dest}"; then
      echo "[k6w] Already installed: ${dest}"
      echo "[k6w]   $("${dest}" version 2>/dev/null | head -1)"
      [[ "${rel_dest}" != "${dest}" ]] && _k6w_ensure_gitignored "${rel_dest}" \
        "k6 binary built by 'k6w install-k6' — a build artifact, not source"
      echo "[k6w] Pass --force to rebuild."
      return 0
    fi
    echo "[k6w] ${dest} exists but has no clickhouse extension — rebuilding it"
  fi

  mkdir -p "${dest_dir}" || {
    echo "[k6w] Error: could not create ${dest_dir}" >&2
    exit 1
  }

  local goos goarch
  goos="$(_k6w_host_goos)"
  goarch="$(_k6w_host_goarch)"

  echo "[k6w] Building k6 ${K6W_K6_VERSION} with ${K6W_XK6_EXTENSION}"
  echo "[k6w]   target: ${goos}/${goarch}"
  echo "[k6w]   output: ${dest}"
  echo "[k6w] This takes a few minutes the first time."

  if command -v docker > /dev/null 2>&1 && docker info > /dev/null 2>&1; then
    echo "[k6w] Using Docker (${K6W_XK6_IMAGE}) — no Go toolchain needed."
    # -u keeps the output owned by the invoking user rather than root. The destination
    # directory is mounted rather than the repo, so the build can only write there.
    if ! docker run --rm \
      -u "$(id -u):$(id -g)" \
      -e "GOOS=${goos}" -e "GOARCH=${goarch}" \
      -e "GOFLAGS=-buildvcs=false" \
      -v "${dest_dir}:/xk6" \
      "${K6W_XK6_IMAGE}" \
      build "${K6W_K6_VERSION}" \
      --with "${K6W_XK6_EXTENSION}" \
      --output "/xk6/${dest_name}"
    then
      echo "[k6w] Error: the Docker build failed." >&2
      echo "[k6w]        Check that Docker can pull ${K6W_XK6_IMAGE} and reach the network." >&2
      exit 1
    fi
  elif command -v xk6 > /dev/null 2>&1; then
    echo "[k6w] Docker unavailable; using the xk6 on PATH."
    if ! GOOS="${goos}" GOARCH="${goarch}" \
      xk6 build "${K6W_K6_VERSION}" \
        --with "${K6W_XK6_EXTENSION}" \
        --output "${dest}"
    then
      echo "[k6w] Error: the xk6 build failed." >&2
      exit 1
    fi
  else
    echo "[k6w] Error: cannot build k6 — neither Docker nor xk6 is available." >&2
    echo "[k6w]        Install one of:" >&2
    echo "[k6w]          Docker    https://docs.docker.com/get-docker/  (no Go needed)" >&2
    echo "[k6w]          xk6       go install go.k6.io/xk6/cmd/xk6@latest" >&2
    echo "[k6w]        Or build the binary elsewhere and point K6W_K6_BIN at it in" >&2
    echo "[k6w]        ${K6W_ENV_FILE_NAME}:" >&2
    echo "[k6w]          xk6 build ${K6W_K6_VERSION} --with ${K6W_XK6_EXTENSION}" >&2
    exit 1
  fi

  chmod +x "${dest}" 2>/dev/null || true

  # Verify rather than trust. A build that produced something unusable, or a
  # cross-compiled binary that cannot run here, is worth saying so now instead of
  # surfacing as a mystery in the middle of a load test.
  if [[ ! -x "${dest}" ]]; then
    echo "[k6w] Error: build reported success but ${dest} is not executable" >&2
    exit 1
  fi
  if _k6w_has_clickhouse "${dest}"; then
    echo "[k6w] Installed: $("${dest}" version 2>/dev/null | head -1)"
  elif "${dest}" version > /dev/null 2>&1; then
    echo "[k6w] Warning: ${dest} runs but does not report the clickhouse extension" >&2
  else
    echo "[k6w] Warning: ${dest} was built but will not run on this machine" >&2
    echo "[k6w]          (built for ${goos}/${goarch})" >&2
  fi

  if [[ "${rel_dest}" != "${dest}" ]]; then
    _k6w_ensure_gitignored "${rel_dest}" \
      "k6 binary built by 'k6w install-k6' — a build artifact, not source"
  fi
}

# Create .insightest.env in the current directory from the template shipped with the
# SDK, and make sure git ignores it. The SDK's postinstall does the same thing on
# install; this is the hand-run equivalent, for a repo that installed before this
# existed, for a clone that deleted the file, or for provisioning a load host.
#
# Never overwrites: the existing file holds a working key, and a scaffolding command
# that discards a credential is a scaffolding command nobody runs twice.
_do_init() {
  local target="${PWD}/${K6W_ENV_FILE_NAME}"

  # The template lives inside the package, alongside the wrapper's own directory.
  # Installed as an npm dependency the wrapper is invoked through
  # node_modules/.bin/k6w, so the package's files are only reachable through the
  # symlink target — the same resolution the k6 binary lookup below performs.
  local template="" candidate self_dir real_dir
  self_dir="$(dirname "${K6W_SELF}")"
  real_dir="$(dirname "$(readlink -f "${K6W_SELF}" 2>/dev/null || printf '%s' "${K6W_SELF}")")"
  for candidate in \
    "${self_dir}/../templates/insightest.env.example" \
    "${real_dir}/../templates/insightest.env.example"
  do
    if [[ -f "${candidate}" ]]; then
      template="${candidate}"
      break
    fi
  done
  if [[ -z "${template}" ]]; then
    echo "[k6w] Error: could not find templates/insightest.env.example in the SDK package" >&2
    exit 1
  fi

  if [[ -e "${target}" ]]; then
    echo "[k6w] ${K6W_ENV_FILE_NAME} already exists — leaving it alone"
  else
    cp "${template}" "${target}"
    chmod 600 "${target}" 2>/dev/null || true
    echo "[k6w] Created ${target}"
    # The file just appeared, so re-read it: install-k6 below needs the K6W_K6_BIN it
    # carries, and the first load happened before it existed.
    K6W_ENV_FILE_LOADED=""
    _load_env_file
  fi

  _k6w_ensure_gitignored "${K6W_ENV_FILE_NAME}" \
    "Insightest performance-test config — holds the project API key"

  # Build the k6 binary too, so one command leaves the repo actually able to run a
  # test. Skippable, because it needs Docker or Go and takes minutes — a repo that
  # already has a binary, or wants to supply its own, should not be made to wait.
  if [[ "${K6W_SKIP_K6_INSTALL:-}" == "1" ]]; then
    echo "[k6w] Skipping the k6 build (K6W_SKIP_K6_INSTALL=1)."
  else
    echo "[k6w] ---"
    _do_install_k6 || true
    echo "[k6w] ---"
  fi

  echo "[k6w] Next: paste a project API key into INSIGHTEST_INGEST_API_KEY."
  echo "[k6w]       Insightest → your project → Run performance tests → Generate API key"
}

# Loaded before the k6 binary is resolved, because K6W_K6_BIN is one of the things
# the file exists to set.
_load_env_file

# The setup subcommands are dispatched here, before the k6 binary is resolved: their
# whole purpose is to run on a host that does not have a usable k6 yet, so they must
# not go through a resolver that exits when K6W_K6_BIN points at nothing.
if [[ "${1:-}" == "init" ]]; then
  _do_init
  exit 0
fi
if [[ "${1:-}" == "install-k6" ]]; then
  _do_install_k6 "${2:-}"
  exit 0
fi

# Resolve the k6 binary to run. This lets the wrapper live in a different location
# from the binary (e.g. k6w installed via an SDK, custom binary installed on the
# host). Resolution order, first match wins:
#   1. K6W_K6_BIN — explicit override (most robust for CI/remote runs)
#   2. a `k6` sitting next to this wrapper — resolves against the wrapper's own
#      directory, not the CWD, so it survives `cd` into a test directory
#   3. a `k6` next to the wrapper's symlink target — when installed as an npm
#      dependency the wrapper is invoked through node_modules/.bin/k6w, so a k6
#      shipped inside the package itself is only visible through the real path
#   4. `k6` found on PATH (e.g. `xk6 build` installed to /usr/local/bin)
#   5. the default install location, tools/k6/k6 under the repo root
#   6. legacy `./k6` relative to the current working directory
_resolve_k6_bin() {
  if [[ -n "${K6W_K6_BIN:-}" ]]; then
    # Relative values resolve against the repo root, not $PWD — see _k6w_repo_root.
    local explicit; explicit="$(_k6w_abs_path "${K6W_K6_BIN}")"
    if [[ ! -x "${explicit}" ]]; then
      echo "[k6w] Error: K6W_K6_BIN=${K6W_K6_BIN} is not an executable file" >&2
      echo "[k6w]        (looked for ${explicit})" >&2
      echo "[k6w]        Run 'k6w install-k6' to build it, or point K6W_K6_BIN at an" >&2
      echo "[k6w]        existing xk6-clickhouse build of k6." >&2
      exit 1
    fi
    printf '%s' "${explicit}"
    return
  fi
  local self_dir; self_dir="$(dirname "${K6W_SELF}")"
  if [[ -x "${self_dir}/k6" ]]; then
    printf '%s' "${self_dir}/k6"
    return
  fi
  if [[ -L "${K6W_SELF}" ]] && command -v readlink > /dev/null 2>&1; then
    local real_dir; real_dir="$(dirname "$(readlink -f "${K6W_SELF}" 2>/dev/null)")"
    if [[ -n "${real_dir}" && -x "${real_dir}/k6" ]]; then
      printf '%s' "${real_dir}/k6"
      return
    fi
  fi
  if command -v k6 > /dev/null 2>&1; then
    command -v k6
    return
  fi
  # Where install-k6 puts it. Checked even when .insightest.env does not name it, so
  # a repo whose config file predates K6W_K6_BIN still finds an installed binary.
  local default_bin; default_bin="$(_k6w_abs_path "${K6W_DEFAULT_K6_BIN}")"
  if [[ -x "${default_bin}" ]]; then
    printf '%s' "${default_bin}"
    return
  fi
  printf '%s' "./k6"
}
K6_BIN="$(_resolve_k6_bin)"

# Warn (don't fail) if the resolved binary doesn't advertise the clickhouse output
# extension — a stock k6 picked up off PATH will run fine but silently stream no
# metrics to ClickHouse, so the run would never appear in the dashboard.
_check_k6_clickhouse() {
  local ver
  ver="$("${K6_BIN}" version 2>/dev/null)" || {
    echo "[k6w] Warning: could not run '${K6_BIN} version' to verify the k6 binary" >&2
    echo "[k6w]          Run 'k6w install-k6' to build the one this SDK expects." >&2
    return
  }
  if ! printf '%s' "${ver}" | grep -qi 'clickhouse'; then
    echo "[k6w] Warning: resolved k6 binary '${K6_BIN}' has no clickhouse extension" >&2
    echo "[k6w]          metrics will NOT reach ClickHouse and the run won't show in the dashboard." >&2
    echo "[k6w]          Run 'k6w install-k6' to build one, or point K6W_K6_BIN at an" >&2
    echo "[k6w]          existing xk6-clickhouse build." >&2
  fi
}
_check_k6_clickhouse

# Fallback address, used only when neither the environment nor .insightest.env names
# one. INSIGHTEST_API_URL belongs in .insightest.env, which is where a deployment
# that has moved off localhost sets it — changing this line means cutting an SDK
# release and bumping the dependency in every test repo, so the file is the answer
# and this is just the local-stack default.
#
# Note this value is public: releases mirror SDKs/k6 to a public repository. Only
# ever put an address here that is fine to publish; INSIGHTEST_INGEST_API_KEY is
# the credential and never belongs in this file.
K6W_DEFAULT_API_URL="http://localhost:4000"

# Running against a local stack, a staging instance or a branch deployment is a
# matter of the INSIGHTEST_API_URL line in .insightest.env, or overriding it once:
#   INSIGHTEST_API_URL=http://localhost:4000 npx k6w run tests/load-test.js
# Exported so it also lands in the run record, which is then explicit about which
# Insightest the run registered against.
export INSIGHTEST_API_URL="${INSIGHTEST_API_URL:-${K6W_DEFAULT_API_URL}}"

# Project API key (X-API-Key), created in Insightest under the project this repo's
# tests belong to. It authenticates every call the wrapper makes and identifies the
# project, so a key issued for one project cannot register runs against another or
# read another's stored configuration — which is why INSIGHTEST_PROJECT is optional
# once a key is set.
#
# By this point it has come from the environment or from .insightest.env (see
# _load_env_file). When it is still unset the calls go out without the header, which
# a deployment with keys configured rejects with 401.
API_KEY_HEADER=()
if [[ -n "${INSIGHTEST_INGEST_API_KEY:-}" ]]; then
  API_KEY_HEADER=(-H "X-API-Key: ${INSIGHTEST_INGEST_API_KEY}")
fi

# Environment profile to request from Insightest (see _fetch_insightest_config).
# "default" is the profile every project has; another name is overlaid on top of it.
K6W_ENV="${K6W_ENV:-default}"

# Names Insightest is never allowed to set on this host, even if a response
# contains them. The first group decides which programs and libraries the shell
# and k6 load; the second is host-local (the k6 binary, the Docker socket) or is
# the bootstrap config used to reach the API in the first place. The API refuses
# to store or serve these too — this is the client half of that check, so an older
# or compromised API cannot push one to a newer wrapper.
K6W_PROTECTED_ENV="PATH IFS ENV BASH_ENV SHELL HOME LD_PRELOAD LD_LIBRARY_PATH
DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH NODE_OPTIONS K6W_K6_BIN K6W_SELF
K6W_RUN_ID K6W_DOCKER_SOCKET K6W_ENV_FILE INSIGHTEST_PROFILE INSIGHTEST_API_URL
INSIGHTEST_INGEST_API_KEY INSIGHTEST_CREDENTIALS INSIGHTEST_MASTER_KEY"

# Names of variables Insightest flagged as secret. Collected by the config fetch
# so _build_env_json masks them instead of recording them in clear on the run.
K6W_SERVER_SECRETS=()

# Docker socket used to sample container stats locally. k6w runs on the host where
# the target containers live, so it reads the daemon here and forwards samples to
# the API — the API never needs Docker access. Override if the socket lives
# elsewhere (e.g. /run/docker.sock or a rootless path).
K6W_DOCKER_SOCKET="${K6W_DOCKER_SOCKET:-/var/run/docker.sock}"
# Seconds between container-stats samples (matches the default k6 clickhouse push interval).
K6W_STATS_INTERVAL="${K6W_STATS_INTERVAL:-2}"

# Soft-fail curl wrapper: skips the call entirely when curl is not installed.
_try_curl() {
  if ! command -v curl > /dev/null 2>&1; then
    echo "[k6w] Warning: curl not available — skipping HTTP call"
    return 0
  fi
  curl "$@"
}

# True when a variable name must never be set from a server response.
_is_protected_env() {
  local candidate protected
  candidate=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  for protected in ${K6W_PROTECTED_ENV}; do
    [[ "${candidate}" == "${protected}" ]] && return 0
  done
  return 1
}

# Fetch this project's stored configuration from Insightest and export it.
#
# This is what keeps connection details and test inputs off the command line: the
# ClickHouse coordinates, the target host, K6W_CONTAINER and anything else stored
# against the project arrive here. It runs before `k6 inspect` and before the k6
# binary starts, so a script that reads a variable at init time sees it.
#
# Precedence: a variable already set in this shell is never overwritten, so an
# explicit `HTTP_HOST=… k6w run …` still points where you told it to. Only
# variables that are unset (or empty) locally are filled in from Insightest.
#
# The response is tab-separated (NAME<TAB>VALUE<TAB>1|0, with the flag marking a
# secret) rather than JSON, because jq is not installed everywhere k6 runs.
# Lines beginning with # are messages from the API and are echoed as warnings.
#
# Best-effort, like registration: a rejected or unreachable API is reported and
# the run continues, since every variable may equally well come from the shell.
# When something really is missing, k6 or the test script says so by name.
_fetch_insightest_config() {
  if [[ "${K6W_SKIP_CONFIG_FETCH:-}" == "1" ]]; then
    return 0
  fi
  if ! command -v curl > /dev/null 2>&1; then
    echo "[k6w] Warning: curl not available — skipping Insightest config fetch" >&2
    return 0
  fi

  # --data-urlencode with -G puts the parameters in the query string already
  # encoded, so a project or profile name containing / or a space is safe.
  local curl_args=(-s -G --data-urlencode "format=env" --data-urlencode "env=${K6W_ENV}")
  if [[ -n "${INSIGHTEST_PROJECT:-}" ]]; then
    curl_args+=(--data-urlencode "project=${INSIGHTEST_PROJECT}")
  fi

  local body_file status
  body_file="$(mktemp 2>/dev/null || echo "/tmp/k6w_config_$$")"
  status=$(curl "${curl_args[@]}" -o "${body_file}" -w '%{http_code}' \
    "${API_KEY_HEADER[@]}" -H 'Accept: text/plain' \
    "${INSIGHTEST_API_URL}/api/k6/config" 2>/dev/null) || status="000"

  if [[ ! "${status}" =~ ^2 ]]; then
    if [[ "${status}" == "000" ]]; then
      echo "[k6w] Warning: could not reach Insightest at ${INSIGHTEST_API_URL} to load configuration" >&2
      echo "[k6w]          continuing with the variables set in this shell." >&2
    else
      echo "[k6w] ============================================================" >&2
      echo "[k6w] WARNING: configuration fetch was REJECTED (HTTP ${status})." >&2
      echo "[k6w]          $(cat "${body_file}" 2>/dev/null)" >&2
      echo "[k6w]          Stored variables (ClickHouse, target hosts, containers)" >&2
      echo "[k6w]          were NOT loaded. Check INSIGHTEST_INGEST_API_KEY and" >&2
      echo "[k6w]          INSIGHTEST_PROJECT, or set the variables in this shell." >&2
      echo "[k6w] ============================================================" >&2
    fi
    rm -f "${body_file}" 2>/dev/null || true
    return 0
  fi

  local applied=0 name value secret
  while IFS=$'\t' read -r name value secret || [[ -n "${name:-}" ]]; do
    [[ -z "${name}" ]] && continue
    if [[ "${name}" == \#* ]]; then
      echo "[k6w] Insightest: ${name#\#}" >&2
      continue
    fi
    if [[ ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]{0,127}$ ]]; then
      echo "[k6w] Warning: ignoring malformed variable name in the Insightest response" >&2
      continue
    fi
    if _is_protected_env "${name}"; then
      echo "[k6w] Warning: refusing to set reserved variable ${name} from Insightest" >&2
      continue
    fi
    # Locally set wins: leave it alone.
    [[ -n "${!name:-}" ]] && continue
    export "${name}=${value}"
    if [[ "${secret:-}" == "1" ]]; then
      K6W_SERVER_SECRETS+=("${name}")
    fi
    applied=$((applied + 1))
  done < "${body_file}"
  rm -f "${body_file}" 2>/dev/null || true

  echo "[k6w] Loaded ${applied} variable(s) from Insightest (environment: ${K6W_ENV})"
}

# Sample Docker stats for one container and post each sample to Insightest until
# killed. Runs in the background for the life of the k6 run. Uses the daemon's
# one-shot stats (stream=false), which already populates precpu_stats so the API
# can compute CPU% from a single sample. Best-effort: transient failures are
# swallowed so a hiccup never kills the collector.
_sample_container_stats() {
  local container="$1"
  local stats
  while true; do
    if stats=$(curl -sf --unix-socket "${K6W_DOCKER_SOCKET}" \
        "http://localhost/containers/${container}/stats?stream=false" 2>/dev/null); then
      curl -sf -X POST "${INSIGHTEST_API_URL}/api/k6/runs/${RUN_ID}/container-stats" \
        "${API_KEY_HEADER[@]}" -H "Content-Type: application/json" \
        -d "{\"container_name\":\"${container}\",\"docker_stats\":${stats}}" > /dev/null 2>&1 || true
    fi
    sleep "${K6W_STATS_INTERVAL}"
  done
}

# Re-run a previous test on THIS host (the one that originally ran it). Asks the
# API to mint a new run id under the same project, restores the stored command/env,
# and re-execs `k6w run …` with K6W_RUN_ID set so the normal run path (container
# stats + /complete) takes over. Execution and metric collection stay local, which
# is what makes rerun work once the API is deployed away from the load host.
_do_rerun() {
  local run_id="$1"
  if [[ -z "${run_id}" ]]; then
    echo "[k6w] Usage: k6w rerun <run_id>" >&2
    exit 1
  fi
  command -v curl > /dev/null 2>&1 || { echo "[k6w] Error: rerun requires curl" >&2; exit 1; }
  command -v jq   > /dev/null 2>&1 || { echo "[k6w] Error: rerun requires jq" >&2; exit 1; }

  local resp
  resp=$(curl -sf -X POST "${INSIGHTEST_API_URL}/api/k6/runs/${run_id}/prepare-rerun" \
    "${API_KEY_HEADER[@]}" -H "Content-Type: application/json") || {
    echo "[k6w] Error: prepare-rerun failed for ${run_id} — check INSIGHTEST_API_URL, INSIGHTEST_INGEST_API_KEY, and that the run exists" >&2
    exit 1
  }

  local new_run_id command work_dir
  new_run_id=$(printf '%s' "${resp}" | jq -r '.run_id // empty')
  command=$(printf '%s' "${resp}" | jq -r '.command // empty')
  work_dir=$(printf '%s' "${resp}" | jq -r '.env_vars._work_dir // empty')
  if [[ -z "${new_run_id}" || -z "${command}" ]]; then
    echo "[k6w] Error: prepare-rerun response missing run_id or command" >&2
    exit 1
  fi

  # Restore the original test's stored env: skip the internal _work_dir key and any
  # masked secret (***). Connection/secret values (ClickHouse creds, ingest key) are
  # not stored server-side, so they come from the current shell env instead.
  while IFS=$'\t' read -r _k _v; do
    [[ -z "${_k}" ]] && continue
    export "${_k}=${_v}"
  done < <(printf '%s' "${resp}" | jq -r '.env_vars // {} | to_entries[] | select(.key != "_work_dir" and .value != "***") | "\(.key)\t\(.value)"')

  export K6W_RUN_ID="${new_run_id}"

  # Re-run from the original working directory so the (relative) script path in the
  # stored command resolves; warn and stay put if it's gone.
  if [[ -n "${work_dir}" && -d "${work_dir}" ]]; then
    cd "${work_dir}" || echo "[k6w] Warning: could not cd to ${work_dir}; running from $(pwd)" >&2
  elif [[ -n "${work_dir}" ]]; then
    echo "[k6w] Warning: stored work_dir ${work_dir} not found; running from $(pwd)" >&2
  fi

  echo "[k6w] Re-running ${run_id} as new run ${new_run_id}"
  # `command` begins with the literal `run …`; intentional word-split to replay the
  # original arguments (matches the server-side rerun's strings.Fields behaviour).
  # shellcheck disable=SC2086
  exec "${K6W_SELF}" ${command}
}

# ── Subcommand dispatch ───────────────────────────────────────────────────────
# `rerun` re-runs a prior test locally; only `run` is instrumented; anything else
# passes straight through to the real k6 binary. (`init` and `install-k6` are handled
# near the top, before the k6 binary is resolved — setup must work before k6 exists.)
if [[ "${1:-}" == "rerun" ]]; then
  _do_rerun "${2:-}"   # execs `k6w run …`; never returns
fi
if [[ "${1:-}" != "run" ]]; then
  exec "${K6_BIN}" "$@"
fi

# A key sitting in a file git would happily commit is worth interrupting for, but
# only on a real run — `k6w init` and pass-through k6 invocations have nothing to do
# with it, and `k6w init` is the thing that fixes it.
_warn_if_env_file_tracked

# Load the project's stored configuration before anything reads the environment:
# `k6 inspect` below, the container-stats collector (K6W_CONTAINER), the k6 output
# extension (K6_CLICKHOUSE_*) and the test script itself all depend on it. This
# runs on the rerun path too, so a replayed run picks up current connection
# details instead of whatever was stored with the original run.
_fetch_insightest_config

# If K6W_RUN_ID is set, a run_id was pre-assigned by the API (rerun path) — skip UUID generation and registration
if [[ -n "${K6W_RUN_ID:-}" ]]; then
  RUN_ID="${K6W_RUN_ID}"
else
  if command -v uuidgen > /dev/null 2>&1; then
    RUN_ID=$(uuidgen)
  elif [[ -r /proc/sys/kernel/random/uuid ]]; then
    RUN_ID=$(cat /proc/sys/kernel/random/uuid)
  else
    echo "[k6w] Error: cannot generate UUID (uuidgen unavailable and /proc/sys/kernel/random/uuid not readable)" >&2
    exit 1
  fi

  # Build a JSON-safe command string (escape backslash and double-quote)
  COMMAND_STR=$(printf '%s ' "$@" | sed 's/\\/\\\\/g; s/"/\\"/g')

  # Collect test-specific env vars as a JSON object.
  # K6_CLICKHOUSE_* are excluded — the server already has them via CLICKHOUSE_* in its own env.
  # INSIGHTEST_PROJECT is recorded so `k6w rerun` can resolve the same project (and
  # with it the same stored configuration) without it being set in the shell.
  # Masked values: anything whose name suggests a credential, plus every variable
  # Insightest served as a secret — those came from the server and are fetched
  # again on the next run, so there is no reason to keep a copy on the run row.
  _build_env_json() {
    local json="{" sep="" server_secret
    while IFS= read -r line; do
      local key="${line%%=*}"
      local val="${line#*=}"
      [[ "$key" =~ ^K6_CLICKHOUSE_(ADDR|USER|PASSWORD|DB)$ ]] && continue
      [[ "$key" == "K6W_RUN_ID" ]] && continue
      [[ "$key" =~ ^K6_ || "$key" =~ ^K6W_ || "$key" == "HTTP_HOST" || "$key" == "INSIGHTEST_API_URL" || "$key" == "INSIGHTEST_PROJECT" ]] || continue
      [[ "$key" =~ PASSWORD|SECRET|TOKEN|API_KEY ]] && val="***"
      for server_secret in ${K6W_SERVER_SECRETS[@]+"${K6W_SERVER_SECRETS[@]}"}; do
        [[ "$key" == "$server_secret" ]] && val="***" && break
      done
      val="${val//\\/\\\\}"; val="${val//\"/\\\"}"
      json+="${sep}\"${key}\":\"${val}\""
      sep=","
    done < <(printenv | sort)
    printf '%s}' "$json"
  }
  ENV_JSON=$(_build_env_json)

  # Extract per-scenario config via `k6 inspect` so the dashboard shows real scenario data.
  # Requires jq; falls back to [] silently when either k6 inspect or jq is unavailable.
  _get_scenarios_json() {
    local script_file=""
    for arg in "$@"; do
      if [[ "${arg}" == *.js ]]; then
        script_file="${arg}"
        break
      fi
    done
    [[ -z "${script_file}" ]] && echo "[]" && return
    command -v jq > /dev/null 2>&1 || { echo "[]"; return; }
    local inspect_out
    inspect_out=$("${K6_BIN}" inspect "${script_file}" 2>/dev/null) || { echo "[]"; return; }
    printf '%s' "${inspect_out}" | jq -c '[
      .options.scenarios // {} | to_entries[] | {
        name: .key,
        executor: (.value.executor // ""),
        vus: (.value.vus // 0),
        duration: (.value.duration // ""),
        status: "running",
        progress: 0
      }
    ]' 2>/dev/null || echo "[]"
  }
  SCENARIOS_JSON=$(_get_scenarios_json "$@")

  # Select the target project via INSIGHTEST_PROJECT, either "name" or the fully
  # qualified "organization/name" (use the latter when the same project name exists
  # in more than one org). When unset, the server falls back to its configured
  # K6_SYNC_PROJECT_ID. The field is omitted entirely when unset so old servers keep working.
  PROJECT_FIELD=""
  if [[ -n "${INSIGHTEST_PROJECT:-}" ]]; then
    _project="${INSIGHTEST_PROJECT//\\/\\\\}"; _project="${_project//\"/\\\"}"
    PROJECT_FIELD="\"project\":\"${_project}\","
  fi

  # Register run with Insightest before k6 starts. Soft-fail: never aborts the k6 run.
  # We capture the HTTP status (instead of curl -f swallowing it) so a rejected
  # registration — wrong ingest key (401) or unknown project (400/404) — produces a
  # loud, actionable banner. Those runs still stream metrics to ClickHouse, but with
  # no registered row they never surface in the dashboard, so silence would hide a
  # misconfiguration. A connectivity failure (status 000) stays a quiet warning.
  WORK_DIR=$(pwd)
  _register_run() {
    command -v curl > /dev/null 2>&1 || {
      echo "[k6w] Warning: curl not available — skipping Insightest registration"
      return 0
    }
    local body_file status
    body_file="$(mktemp 2>/dev/null || echo /tmp/k6w_register_$$)"
    status=$(curl -s -o "${body_file}" -w '%{http_code}' \
      -X POST "${INSIGHTEST_API_URL}/api/k6/runs/register" \
      "${API_KEY_HEADER[@]}" \
      -H "Content-Type: application/json" \
      -d "{${PROJECT_FIELD}\"run_id\":\"${RUN_ID}\",\"command\":\"${COMMAND_STR}\",\"work_dir\":\"${WORK_DIR}\",\"env_vars\":${ENV_JSON},\"scenarios\":${SCENARIOS_JSON}}" \
      2>/dev/null) || status="000"

    if [[ "${status}" =~ ^2 ]]; then
      rm -f "${body_file}" 2>/dev/null || true
      return 0
    fi

    if [[ "${status}" == "000" ]]; then
      echo "[k6w] Warning: could not reach Insightest at ${INSIGHTEST_API_URL} to register the run — continuing anyway" >&2
    else
      local body; body="$(cat "${body_file}" 2>/dev/null)"
      echo "[k6w] ============================================================" >&2
      echo "[k6w] WARNING: run registration was REJECTED (HTTP ${status})." >&2
      echo "[k6w]          ${body}" >&2
      echo "[k6w]          This run will NOT appear in Insightest. Metrics still" >&2
      echo "[k6w]          stream to ClickHouse, but with no registered run there is" >&2
      echo "[k6w]          nothing for the dashboard to attach them to." >&2
      echo "[k6w]          Check INSIGHTEST_INGEST_API_KEY and INSIGHTEST_PROJECT" >&2
      echo "[k6w]          (the org/project must already exist in Insightest)." >&2
      echo "[k6w] ============================================================" >&2
    fi
    rm -f "${body_file}" 2>/dev/null || true
  }
  _register_run
fi

# Start container stats collection for each container in K6W_CONTAINER.
# K6W_CONTAINER is a comma-separated list (a single name still works). Each
# container gets a background loop that samples the local Docker socket and posts
# samples to the API. Collection is best-effort: missing curl or docker socket
# skips it entirely and never aborts the k6 run.
_STATS_PIDS=()
if [[ -n "${K6W_CONTAINER:-}" ]]; then
  if ! command -v curl > /dev/null 2>&1; then
    echo "[k6w] Warning: curl not available — skipping container stats"
  elif [[ ! -S "${K6W_DOCKER_SOCKET}" ]]; then
    echo "[k6w] Warning: docker socket ${K6W_DOCKER_SOCKET} not found — skipping container stats"
  else
    IFS=',' read -ra _K6W_CONTAINERS <<< "${K6W_CONTAINER}"
    for _container in "${_K6W_CONTAINERS[@]}"; do
      _container="${_container#"${_container%%[![:space:]]*}"}"  # trim leading whitespace
      _container="${_container%"${_container##*[![:space:]]}"}"  # trim trailing whitespace
      [[ -z "${_container}" ]] && continue
      _sample_container_stats "${_container}" &
      _STATS_PIDS+=("$!")
    done
  fi
fi

# Delegate to the real k6 binary; k6w stays alive as supervisor and forwards k6's exit code.
# Capture the code with `|| K6_EXIT=$?` so `set -e` does NOT abort the wrapper when k6 exits
# non-zero (e.g. a script that fails to start) — otherwise the /complete callback below would
# never fire and the run would be stuck "running" forever.
K6_EXIT=0
"${K6_BIN}" "$@" --tag run_id="${RUN_ID}" || K6_EXIT=$?

# Stop container stats collection: kill each background sampler and reap it.
if [[ ${#_STATS_PIDS[@]} -gt 0 ]]; then
  for _pid in "${_STATS_PIDS[@]}"; do
    kill "${_pid}" 2>/dev/null || true
  done
  wait "${_STATS_PIDS[@]}" 2>/dev/null || true
fi

# Report completion so the API finalizes the run promptly (soft-fail: if this never
# lands, the run stays "running" and the backstop sync finalizes it later).
_try_curl -sf -X POST "${INSIGHTEST_API_URL}/api/k6/runs/${RUN_ID}/complete" \
  "${API_KEY_HEADER[@]}" \
  -H "Content-Type: application/json" \
  -d "{\"exit_code\":${K6_EXIT}}" \
  || echo "[k6w] Warning: completion report failed — backstop sync will finalize"

exit $K6_EXIT
